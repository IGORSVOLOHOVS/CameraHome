# --- Telegram Bot Config ---
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# --- Google Sheets Config ---
SPREADSHEET_ID=your_google_spreadsheet_id
